{
  "name": "desktop-schedule",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:start": "npm run build && electron .",
    "electron:dev": "node scripts/desktop-dev.js",
    "desktop:pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "description": "A mindful desktop schedule and task manager with frosted-glass design.",
  "author": "Ethereal contributors",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "homepage": ".",
  "build": {
    "appId": "com.ethereal.schedule",
    "productName": "Ethereal Schedule",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "electron/assets"
    },
    "files": [
      "build/**/*",
      "electron/main.js",
      "electron/preload.js",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extends": null
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
